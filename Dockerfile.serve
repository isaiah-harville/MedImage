# The demo inference service (opendiagnostics-serve). The image holds no models: the service
# downloads the published ones from the weights bucket at startup and on a timer.
# Build context: the repository root. CI builds it in .github/workflows/serve-image.yml.
FROM python:3.12-slim-bookworm AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src src
COPY tests tests
COPY configs configs
COPY scripts scripts
# Lint, type-check, and run the service's tests so a broken commit cannot become an image.
# The full suite runs in CI before this build.
RUN uv sync --locked --extra cpu --extra serve \
 && uv run --no-sync ruff format --check src tests \
 && uv run --no-sync ruff check src tests \
 && uv run --no-sync ty check src \
 && uv run --no-sync pytest -q -p no:warnings tests/test_serve.py tests/test_serve_weights.py tests/test_examples.py tests/test_metrics_classification.py
RUN UV_PROJECT_ENVIRONMENT=/opt/venv uv sync --locked --extra cpu --extra serve --no-dev --no-editable

FROM python:3.12-slim-bookworm
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid 10001 --no-create-home app
COPY --from=build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    LISTEN_ADDRESS=:8080 \
    HOME=/tmp \
    MPLCONFIGDIR=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
USER 10001:10001
EXPOSE 8080
CMD ["opendiagnostics-serve"]
